{
  "name": "talks",
  "type": "module",
  "private": true,
  "scripts": {
    "clear-dist": "rimraf ./dist",
    "build": "pnpm clear-dist && pnpm run \"/^build:.*/\" && cat dist/*/_redirects > dist/_redirects",
    "export": "slidev export",
    "build:nix": "slidev build nix/slides.md --base /nix/ --out ../dist/nix",
    "dev:nix": "slidev nix/slides.md",
    "build:activitypub": "slidev build activitypub/slides.md --base /activitypub/ --out ../dist/activitypub",
    "dev:activitypub": "slidev activitypub/slides.md"
  },
  "devDependencies": {
    "@iconify-json/logos": "1.2.11",
    "@iconify-json/mdi": "1.2.3",
    "@slidev/cli": "52.18.0",
    "@slidev/theme-apple-basic": "0.25.1",
    "playwright-chromium": "1.60.0",
    "rimraf": "6.1.3"
  },
  "packageManager": "pnpm@10.33.4+sha512.1c67b3b359b2d408119ba1ed289f34b8fc3c6873412bec6fd264fbdc82489e510fcbecb9ce9d22dae7f3b76269d8441046014bdca53b9979cd7a561ad631b800"
}
