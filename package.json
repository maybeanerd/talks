{
  "name": "talks",
  "type": "module",
  "private": true,
  "scripts": {
    "clear-dist": "rimraf ./dist",
    "build": "pnpm clear-dist && pnpm run \"/^build:.*/\" && cp index.html dist/",
    "build:nix": "slidev build nix/slides.md --base /nix/ --out ../dist/nix",
    "dev:nix": "slidev nix/slides.md",
    "build:activitypub": "slidev build activitypub/slides.md --base /activitypub/ --out ../dist/activitypub",
    "dev:activitypub": "slidev activitypub/slides.md"
  },
  "devDependencies": {
    "@iconify-json/logos": "1.2.18",
    "@iconify-json/mdi": "1.2.3",
    "@slidev/cli": "53.0.0",
    "@slidev/theme-apple-basic": "0.25.1",
    "rimraf": "6.1.3"
  },
  "packageManager": "pnpm@12.9.0"
}
